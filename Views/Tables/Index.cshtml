@model List<TableView3D.Models.RestaurantTable>
@{
    ViewData["Title"] = "Tables";
}

<h1>Our tables</h1>

<table class="table">
    <thead>
        <tr><th>Table</th><th>Seats</th><th>Location</th></tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Number</td>
                <td>@t.Seats</td>
                <td>@t.Location</td>
            </tr>
        }
    </tbody>
</table>